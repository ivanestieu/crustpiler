digraph AST {
  rankdir=TB;
  node [fontname="monospace", fontsize=10];
  edge [fontname="monospace"];
  n0 [label="Decl", shape=box, style=filled, fillcolor="#c8e6c9"];
  n1 [label="int", shape=ellipse, style=filled, fillcolor="#bbdefb"];
  n0 -> n1 [label="spec", fontsize=9, color=gray40];
  n2 [label="InitDeclarator", shape=box, style=filled, fillcolor="#c8e6c9"];
  n3 [label="Ident 'a'", shape=ellipse, style=filled, fillcolor="#bbdefb"];
  n2 -> n3;
  n4 [label="Str \\\"\"caf\\u00e9\\t\\x41B\\0\\101\\\\\\\"\\q\nend\"\\\"", shape=ellipse, style=filled, fillcolor="#fff9c4"];
  n2 -> n4 [label="init", fontsize=9, color=gray40];
  n0 -> n2 [label="declarator", fontsize=9, color=gray40];
}
